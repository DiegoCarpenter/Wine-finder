{
  "expo": {
    "name": "Wine-finder",
    "slug": "Wine-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Wine-finder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Winefinder",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wine Finder uses your location to show nearby wineries and sort them by distance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wine Finder uses your camera to overlay nearby wineries on a live view of your surroundings.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Wine Finder uses motion sensors to keep winery labels aligned as you tilt your phone."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bc709955-3d05-4fbc-a775-08ca883b1791"
      }
    }
  }
}
